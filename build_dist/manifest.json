{
  "manifest_version": 3,
  "name": "PakDigital AI Auto Commenter",
  "version": "1.2.0",
  "description": "Smart AI-assisted response generator and lead engagement assistant for Facebook.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "contextMenus",
    "scripting"
  ],
  "host_permissions": [
    "*://*.facebook.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "PakDigital AI Agent",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://*.facebook.com/*"],
      "js": ["license_manager.js", "ai_engine.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
